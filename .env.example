# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- LLM provider -------------------------------------------------------
# Gliaent talks to OpenRouter by default. Use an OpenRouter key here; an
# OpenAI key will be rejected by OpenRouter's API.
OPENROUTER_API_KEY=
# Optional: only if you point GLIAENT_LLM_BASE_URL at OpenAI directly.
OPENAI_API_KEY=
# Override the default model / endpoint instead of editing source.
GLIAENT_LLM_BASE_URL=https://openrouter.ai/api/v1
GLIAENT_LLM_MODEL=openai/gpt-4o-mini

# --- NCBI (PubMed / GEO) -----------------------------------------------
# REQUIRED by NCBI's terms: your own email, used to contact you about
# excessive usage. Do not ship someone else's. An API key raises the
# rate limit from 3 to 10 requests/second.
NCBI_EMAIL=
NCBI_API_KEY=

# --- Server -------------------------------------------------------------
# Secret used to sign session tokens. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# The server refuses to start without this unless GLIAENT_DEV=1.
GLIAENT_SECRET_KEY=
GLIAENT_HOST=127.0.0.1
GLIAENT_PORT=8000
# Set to 1 only for local development: enables autoreload and a dev token.
GLIAENT_DEV=0
